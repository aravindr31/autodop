{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoDOP",
  "version": "0.1.0",
  "identifier": "in.aravind.autodop",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:4321",
    "beforeDevCommand": "npm --prefix frontend run dev",
    "beforeBuildCommand": "npm --prefix frontend run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AutoDOP",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}